@model List<Ftec.ProjetosWeb.Pagamento.Web.Models.TransportadoraViewModel>
@{
    ViewData["Title"] = "Transportadoras";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Transportadoras</h2>
    <a asp-action="Criar" class="btn btn-primary">+ Nova Transportadora</a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Código Serviço</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Nome</td>
                <td><code>@t.CodigoServico</code></td>
                <td>
                    <span class="badge @(t.Ativo ? "bg-success" : "bg-secondary")">
                        @(t.Ativo ? "Ativa" : "Inativa")
                    </span>
                </td>
                <td>
                    @if (t.Ativo)
                    {
                        <form asp-action="Desativar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.TransportadoraId" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Desativar</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Ativar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@t.TransportadoraId" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-success">Ativar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
