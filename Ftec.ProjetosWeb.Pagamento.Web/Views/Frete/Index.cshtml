@model List<Ftec.ProjetosWeb.Pagamento.Web.Models.FreteViewModel>
@{
    ViewData["Title"] = "Fretes";
    string[] statusNomes = { "Pendente", "Preparando", "Enviado", "Em Trânsito", "Entregue", "Cancelado" };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Fretes</h2>
    <a asp-action="Calcular" class="btn btn-primary">+ Calcular Frete</a>
</div>

@if (TempData["Sucesso"] is not null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] is not null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Pedido</th>
            <th>Transportadora</th>
            <th>Valor</th>
            <th>Prazo</th>
            <th>Rastreio</th>
            <th>Status</th>
            <th>Criado em</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td><code>@f.PedidoId.ToString()[..8]...</code></td>
                <td>@f.NomeTransportadora</td>
                <td>R$ @f.ValorFrete.ToString("F2")</td>
                <td>@f.PrazoEntrega dias</td>
                <td>@(f.CodigoRastreio ?? "-")</td>
                <td>
                    <span class="badge @(f.StatusEntrega == 5 ? "bg-success" : f.StatusEntrega == 6 ? "bg-danger" : "bg-warning text-dark")">
                        @(f.StatusEntrega >= 1 && f.StatusEntrega <= statusNomes.Length ? statusNomes[f.StatusEntrega - 1] : f.StatusEntrega.ToString())
                    </span>
                </td>
                <td>@f.CriadoEm.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="Detalhes" asp-route-id="@f.IdFrete" class="btn btn-sm btn-outline-primary">Detalhes</a>
                </td>
            </tr>
        }
    </tbody>
</table>
