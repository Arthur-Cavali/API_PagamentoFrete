@model Ftec.ProjetosWeb.Pagamento.Web.Models.CriarPagamentoViewModel
@{
    ViewData["Title"] = "Novo Pagamento";
}

<h2>Novo Pagamento</h2>

<div class="card" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Criar" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="PedidoId" class="form-label">ID do Pedido</label>
                <div class="input-group">
                    <input asp-for="PedidoId" id="pedidoIdInput" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                    <button type="button" class="btn btn-outline-secondary" onclick="buscarPedido()">Buscar Pedido</button>
                </div>
                <span asp-validation-for="PedidoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CpfCliente" class="form-label">CPF do Cliente</label>
                <input asp-for="CpfCliente" class="form-control" placeholder="000.000.000-00" />
                <span asp-validation-for="CpfCliente" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ValorProdutos" class="form-label">Valor dos Produtos (R$)</label>
                <input asp-for="ValorProdutos" id="valorProdutos" class="form-control" type="number" step="0.01" min="0" />
                <small class="text-muted">Preenchido automaticamente ao buscar o pedido.</small>
                <span asp-validation-for="ValorProdutos" class="text-danger"></span>
            </div>

            <div class="alert alert-info py-2 mb-3">
                <small><strong>Valor do Frete:</strong> preenchido automaticamente a partir do frete calculado para o pedido.</small>
            </div>

            <div class="mb-3">
                <label asp-for="MetodoPagamento" class="form-label">Método de Pagamento</label>
                <select asp-for="MetodoPagamento" id="metodoPagamento" class="form-select">
                    <option value="1">Cartão de Crédito</option>
                    <option value="2">Cartão de Débito</option>
                    <option value="3">Pix</option>
                    <option value="4">Boleto</option>
                </select>
                <span asp-validation-for="MetodoPagamento" class="text-danger"></span>
            </div>

            <div class="mb-3" id="parcelasContainer">
                <label asp-for="NumeroParcelas" class="form-label">Número de Parcelas</label>
                <select asp-for="NumeroParcelas" id="numeroParcelas" class="form-select">
                    <option value="1">1x (à vista)</option>
                    <option value="2">2x sem juros</option>
                    <option value="3">3x sem juros</option>
                    <option value="4">4x sem juros</option>
                    <option value="5">5x sem juros</option>
                    <option value="6">6x sem juros</option>
                    <option value="7">7x com juros (2,2% a.m.)</option>
                    <option value="8">8x com juros (2,2% a.m.)</option>
                    <option value="9">9x com juros (2,2% a.m.)</option>
                    <option value="10">10x com juros (2,2% a.m.)</option>
                    <option value="11">11x com juros (2,2% a.m.)</option>
                    <option value="12">12x com juros (2,2% a.m.)</option>
                </select>
                <div id="previewParcela" class="form-text text-primary fw-bold mt-1"></div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Criar Pagamento</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const metodoSelect = document.getElementById('metodoPagamento');
    const parcelasContainer = document.getElementById('parcelasContainer');
    const parcelasSelect = document.getElementById('numeroParcelas');
    const valorInput = document.getElementById('valorProdutos');
    const preview = document.getElementById('previewParcela');

    function toggleParcelas() {
        const isCredito = metodoSelect.value === '1';
        parcelasContainer.style.display = isCredito ? '' : 'none';
        if (!isCredito) parcelasSelect.value = '1';
        atualizarPreview();
    }

    function atualizarPreview() {
        const isCredito = metodoSelect.value === '1';
        if (!isCredito) { preview.textContent = ''; return; }

        const valor = parseFloat(valorInput.value) || 0;
        if (valor <= 0) { preview.textContent = ''; return; }

        const n = parseInt(parcelasSelect.value);
        let total = valor;
        if (n > 6) {
            total = valor * Math.pow(1.022, n);
        }
        const parcela = total / n;
        const juros = n > 6 ? ` (total com juros: R$ ${total.toFixed(2)})` : ' (sem juros)';
        preview.textContent = `${n}x de R$ ${parcela.toFixed(2)}${juros}`;
    }

    metodoSelect.addEventListener('change', toggleParcelas);
    parcelasSelect.addEventListener('change', atualizarPreview);
    valorInput.addEventListener('input', atualizarPreview);

    toggleParcelas();

    function buscarPedido() {
        const id = document.getElementById('pedidoIdInput').value.trim();
        if (!id) { alert('Digite o ID do pedido antes de buscar.'); return; }
        window.location.href = '/Pagamento/BuscarPedido?pedidoId=' + id;
    }
</script>
}
