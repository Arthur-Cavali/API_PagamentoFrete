@model Ftec.ProjetosWeb.Pagamento.Web.Models.ProcessarGatewayViewModel
@{
    ViewData["Title"] = "Processar Pagamento";
}

<h2>Processar Pagamento via Gateway</h2>

<div class="card" style="max-width:500px">
    <div class="card-body">
        <form asp-action="ProcessarGateway" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="PagamentoId" />

            <div class="mb-3">
                <label class="form-label">ID do Pagamento</label>
                <input class="form-control" value="@Model.PagamentoId" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Valor" class="form-label">Valor Cobrado (R$)</label>
                <input asp-for="Valor" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RetornoGateway" class="form-label">Retorno do Gateway</label>
                <input asp-for="RetornoGateway" class="form-control" placeholder="ex: APROVADO, NEGADO" />
                <span asp-validation-for="RetornoGateway" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Status da Transação</label>
                <div class="form-check">
                    <input asp-for="StatusTransacao" class="form-check-input" type="checkbox" />
                    <label asp-for="StatusTransacao" class="form-check-label">Aprovado</label>
                </div>
                <span asp-validation-for="StatusTransacao" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Processar</button>
                <a asp-action="Detalhes" asp-route-id="@Model.PagamentoId" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
